rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function active() { return signedIn() && profile().active == true; }
    function isHead() { return active() && profile().role == 'head'; }
    function isWorker() { return active() && (profile().workerAccess == true || !('workerAccess' in profile())); }
    function isController() { return active() && (profile().controllerAccess == true || (!('controllerAccess' in profile()) && profile().role == 'controller')); }
    function operationalUser() { return isHead() || isController() || isWorker(); }

    match /system_health/angular-client { allow read: if resource.data.public == true; allow write: if false; }
    match /system_config/access_control { allow read, write: if false; }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isHead());
      allow list: if isHead() || (operationalUser() && resource.data.active == true);
      allow create: if isHead() && request.resource.data.uid == userId
        && request.resource.data.role in ['worker','controller'] && request.resource.data.active == true
        && request.resource.data.workerAccess is bool && request.resource.data.controllerAccess is bool;
      allow update: if isHead() && request.resource.data.uid == resource.data.uid
        && resource.data.role in ['worker','controller']
        && request.resource.data.role in ['worker','controller']
        && request.resource.data.workerAccess is bool && request.resource.data.controllerAccess is bool
        && request.resource.data.email == resource.data.email;
      allow delete: if false;
    }

    match /master_data/{id} {
      allow read: if id == 'workers' || operationalUser();
      allow create, update, delete: if isHead();
    }

    match /daily_records/{recordDate} {
      function visibleDay() { return resource.data.status in ['published', 'completed', 'day_off']; }
      allow read: if isHead() || (operationalUser() && visibleDay());
      allow create, update, delete: if isHead();

      match /work_entries/{entryId} {
        function published() { return get(/databases/$(database)/documents/daily_records/$(recordDate)).data.status == 'published'; }
        function resultOnly() {
          return request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['quantity','unit','updatedAt','submittedBy','submittedByName'])
            && request.resource.data.submittedBy == request.auth.uid;
        }
        allow read: if isHead() || (operationalUser()
          && get(/databases/$(database)/documents/daily_records/$(recordDate)).data.status in ['published','completed']);
        allow create, delete: if isHead();
        allow update: if isHead() || (isController() && published() && resultOnly())
          || (isWorker() && published() && resource.data.workerUid == request.auth.uid
            && request.resource.data.workerUid == resource.data.workerUid && resultOnly());
      }

      match /raw_entries/{entryId} {
        function published() { return get(/databases/$(database)/documents/daily_records/$(recordDate)).data.status == 'published'; }
        function resultOnly() {
          return request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['galas','updatedAt','submittedBy','submittedByName'])
            && request.resource.data.submittedBy == request.auth.uid
            && request.resource.data.galas is list && request.resource.data.galas.size() == 6;
        }
        allow read: if isHead() || (operationalUser()
          && get(/databases/$(database)/documents/daily_records/$(recordDate)).data.status in ['published','completed']);
        allow create, delete: if isHead();
        allow update: if isHead() || (isController() && published() && resultOnly());
      }

      match /incoming_entries/{entryId} {
        function published() { return get(/databases/$(database)/documents/daily_records/$(recordDate)).data.status == 'published'; }
        function resultOnly() {
          return request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['quantity','unit','updatedAt','submittedBy','submittedByName'])
            && request.resource.data.quantity is number && request.resource.data.quantity >= 0
            && request.resource.data.unit is string && request.resource.data.submittedBy == request.auth.uid;
        }
        allow read: if isHead() || (operationalUser()
          && get(/databases/$(database)/documents/daily_records/$(recordDate)).data.status in ['published','completed']);
        allow create, delete: if isHead();
        allow update: if isHead() || (isController() && published() && resultOnly());
      }

      match /output_cycles/{cycleId} {
        function published() { return get(/databases/$(database)/documents/daily_records/$(recordDate)).data.status == 'published'; }
        function sameMachinePlan(before, after) {
          return before.workers == after.workers && before.workerUids == after.workerUids
            && before.part == after.part && before.grade == after.grade && before.type == after.type
            && before.shift == after.shift && before.shiftNumber == after.shiftNumber
            && before.requiredQuantity == after.requiredQuantity && before.plannedLot == after.plannedLot;
        }
        function workerMachine(before, after) {
          return before == after || (request.auth.uid in before.workerUids && sameMachinePlan(before, after));
        }
        function commonCycleUpdate() {
          return resource.data.schemaVersion == 2 && request.resource.data.schemaVersion == 2
            && request.resource.data.galaNumber == resource.data.galaNumber
            && request.resource.data.machines is list
            && request.resource.data.machines.size() == resource.data.machines.size()
            && request.resource.data.machines.size() >= 1 && request.resource.data.machines.size() <= 2
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['machines','updatedAt','submittedBy','submittedByName'])
            && request.resource.data.submittedBy == request.auth.uid;
        }
        function controllerResultOnly() {
          return commonCycleUpdate()
            && sameMachinePlan(resource.data.machines[0], request.resource.data.machines[0])
            && (resource.data.machines.size() == 1
              || sameMachinePlan(resource.data.machines[1], request.resource.data.machines[1]));
        }
        function workerResultOnly() {
          return commonCycleUpdate()
            && workerMachine(resource.data.machines[0], request.resource.data.machines[0])
            && (resource.data.machines.size() == 1
              || workerMachine(resource.data.machines[1], request.resource.data.machines[1]));
        }
        allow read: if isHead() || (operationalUser()
          && get(/databases/$(database)/documents/daily_records/$(recordDate)).data.status in ['published','completed']);
        allow create, delete: if isHead();
        allow update: if isHead() || (isController() && published() && controllerResultOnly())
          || (isWorker() && published() && workerResultOnly());
      }
    }

    match /activity_logs/{logId} {
      allow read: if isHead();
      allow create: if operationalUser()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorName == profile().displayName
        && (request.resource.data.actorRole == 'head' && isHead()
          || request.resource.data.actorRole == 'controller' && isController()
          || request.resource.data.actorRole == 'worker' && isWorker())
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly(['recordDate','section','action','recordId','previousValue','newValue','details','actorName','actorUid','actorRole','createdAt']);
      allow update, delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
