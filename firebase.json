{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "dist/fashy-plastics/browser",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [{"source": "**", "destination": "/index.html"}],
    "headers": [
      {"source": "/ngsw-worker.js", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
      {"source": "/ngsw.json", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
      {"source": "**/*.@(js|css|svg|png|webp|woff2)", "headers": [{"key": "Cache-Control", "value": "public,max-age=31536000,immutable"}]}
    ]
  }
}
